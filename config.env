# Base section options
KERNEL_SOURCE=https://github.com/MrShockWAVEog/android_kernel_xiaomi_mt6768-k419.git
KERNEL_SOURCE_BRANCH=test
KERNEL_ARCH=arm64
KERNEL_CONFIG_MONOLITHIC=false
KERNEL_IMAGE_NAME=Image.gz-dtb

# Compiler section options
CC_CLANG_ENABLE=true
CC_CLANG_SOURCE=https://github.com/MrShockWAVEog/Google-Clang-Mirror/releases/download/clang-r614150-aosp/clang.tar.gz
CC_CLANG_BRANCH=
CC_CMDS=LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi- CROSS_COMPILE_COMPAT=arm-linux-gnueabi- CONFIG_NO_ERROR_ON_MISMATCH=y TARGET_BUILD_VARIANT=user

# Anykernel3 section options
ANYKERNEL3_ENABLE=true
ANYKERNEL3_SOURCE=https://github.com/MrShockWAVEog/AnyKernel3.git
ANYKERNEL3_BRANCH=shockwave

# KernelSU section options
KERNELSU_ENABLE=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/MrShockWAVEog/KernelSU/shockwave/kernel/setup.sh
KERNELSU_TAG=shockwave
KERNELSU_EXPECTED_SIZE=
KERNELSU_EXPECTED_HASH=
KERNELSU_REVERT_GKI=false

# APatch section options
APATCH_ENABLE=false

# Misc section options
NEED_PYTHON2=false
NEED_SOME_PACKAGES=false
